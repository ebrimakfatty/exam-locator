{
    "name": "exam-classroom-locator",
    "version": "0.1.0",
    "description": "Fergusson College Exam Classroom Locator",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node src/server.js",
        "db:init": "node src/db/init.js",
        "db:seed-rooms": "node src/db/run-sql-file.js src/db/seed_buildings_rooms.sql",
